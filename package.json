{
  "name": "kampit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.ts",
    "db:migrate:postgres": "node --disable-warning=ExperimentalWarning scripts/migrate-sqlite-to-postgres.ts",
    "setup:ton-testnet": "node --disable-warning=ExperimentalWarning scripts/setup-ton-testnet.ts"
  },
  "dependencies": {
    "@ton/core": "^0.62.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.1.0",
    "@tonconnect/ui": "5.0.1",
    "postgres": "^3.4.7"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "bigint-buffer",
      "bufferutil",
      "utf-8-validate"
    ]
  }
}
